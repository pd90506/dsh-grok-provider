{
  "name": "dsh-grok-provider",
  "version": "2.0.0-alpha.0",
  "description": "DeepSeek Harness SuperGrok / xAI OAuth LLM adapter (clean-room, DSH 0.1.5-rc.2)",
  "type": "module",
  "license": "MIT",
  "author": "pd90506",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pd90506/dsh-grok-provider.git"
  },
  "homepage": "https://github.com/pd90506/dsh-grok-provider#readme",
  "bugs": {
    "url": "https://github.com/pd90506/dsh-grok-provider/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/host/index.mjs",
  "exports": {
    ".": {
      "default": "./dist/host/index.mjs"
    },
    "./client": {
      "default": "./dist/client/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "grok-provider.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "grok-provider.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "esbuild": "0.25.12"
  }
}
